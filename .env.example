# Sao chép thành .env (chmod 600) rồi điền giá trị thật. KHÔNG commit file .env.

# --- PostgreSQL có sẵn (container tts-db, network tts-db-network) ---
# DB_URL được compose ghép từ DB_HOST, DB_PORT, DB_NAME
# Tên network Docker chứa container Postgres (xem: docker inspect tts-db)
DB_NETWORK=tts-db-network
DB_HOST=tts-db
DB_PORT=5432
DB_NAME=tts
DB_USER=tts
DB_PASSWORD=change-me
# true (mặc định): tự tạo database nếu chưa có (cần tài khoản có quyền CREATEDB, ví dụ postgres)
DB_AUTO_CREATE=true

# --- vieneu-service (engine TTS) ---
# Cùng server Ubuntu: có thể dùng URL public, hoặc http://vieneu-service:8000 nếu backend nối chung network với engine
VIENEU_API_URL=https://tts.thongtinchinhhieu.site
VIENEU_API_KEY=change-me
# Để trống nếu engine không yêu cầu trường "model"
VIENEU_MODEL=

# --- Backend ---
# Nhiều origin cách nhau bằng dấu phẩy
CORS_ALLOWED_ORIGINS=http://localhost:8020
# Mã quản trị để tạo/cập nhật giọng mẫu (header X-Admin-Token). Để trống = tắt các endpoint /api/v1/admin
ADMIN_TOKEN=
MAX_TEXT_LENGTH=2000
MAX_PENDING_JOBS=10
MAX_JOBS_PER_IP_PER_HOUR=10
FILE_TTL_HOURS=24
MAX_TTL_HOURS=720
TZ=Asia/Ho_Chi_Minh
